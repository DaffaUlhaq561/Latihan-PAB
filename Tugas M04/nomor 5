enum class CourseStatus {
    ACTIVE, COMPLETED
}

data class Course(
    val code: String,
    val name: String,
    val status: CourseStatus
) {
    companion object {
        const val PREFIX = "PAB"
    }
}

object AppConfig {
    const val MAX_COURSES = 5
}

fun MutableList<Course>.addCourse(course: Course): Boolean =
    size < AppConfig.MAX_COURSES &&
    course.code.startsWith(Course.PREFIX) &&
    add(course)

fun main() {
    val mataKuliah = mutableListOf(
        Course("PAB101", "Mobile App Development", CourseStatus.ACTIVE),
        Course("PAB102", "Kotlin", CourseStatus.COMPLETED)
    )

    val course1 = Course("PAB103","Machine Learning",CourseStatus.ACTIVE)

    val course2 = Course("IF104","Data Science",CourseStatus.ACTIVE)

    println(mataKuliah.addCourse(course1))
    println(mataKuliah.addCourse(course2))

    for (course in mataKuliah) {
        println("${course.code} - ${course.name} - ${course.status}")
    }
}
